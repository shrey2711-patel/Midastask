# OfficeTask Environment Configuration
PORT=5555

# MongoDB Atlas Connection String (M0 Free Tier)
# Replace with your cluster connection URI from cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/officetask?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=super_secret_jwt_key_officetask_secure_2026_xyz!
JWT_EXPIRES_IN=7d

# Default Initial Administrator Account
ADMIN_EMAIL=admin@officetask.com
ADMIN_PASSWORD=Admin@12345

# Device Pre-Shared Authorization Keys
DEVICE_KEY_01=key-office-pc-01
DEVICE_KEY_02=key-office-pc-02
DEVICE_KEY_03=key-office-pc-03

# CORS Configuration
CORS_ORIGIN=*
